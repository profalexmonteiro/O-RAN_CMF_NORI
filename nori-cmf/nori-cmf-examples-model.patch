+// ---------------------------------------------------------------------------
+// Radio
+// ---------------------------------------------------------------------------
+
+double
+CmfSimulation::RxPowerDbm(const UserEquipment& ue, uint32_t bsIdx) const
+{
+    const BaseStation& bs = m_bs[bsIdx];
+    const double d2d = std::hypot(ue.pos.x - bs.pos.x, ue.pos.y - bs.pos.y);
+    const double pl = UmaPathloss(d2d,
+                                  m_cfg.bsHeight,
+                                  m_cfg.ueHeight,
+                                  m_cfg.centreFrequencyHz / 1e9,
+                                  ue.los[bsIdx] != 0);
+    return m_cfg.bsTxPowerDbm + m_cfg.bsAntennaGainDb - m_cfg.bsCableLossDb +
+           m_cfg.ueAntennaGainDb - m_cfg.ueCableLossDb - pl - m_cfg.bodyLossDb -
+           m_cfg.slowFadingMarginDb - m_cfg.foliageLossDb - m_cfg.rainMarginDb;
+}
+
+double
+CmfSimulation::SpectralEfficiency(double sinrDb) const
+{
+    const uint32_t streams = (sinrDb >= m_cfg.mimoSinrThresholdDb) ? m_cfg.mimoStreams : 1;
+    const double perStream = DbToLin(sinrDb) / streams;
+    return streams * std::min(std::log2(1.0 + perStream), m_cfg.maxSpectralEfficiency);
+}
+
+uint32_t
+CmfSimulation::PrbsNeeded(double demandBps, double sinrDb) const
+{
+    const double se = SpectralEfficiency(sinrDb);
+    if (se <= 0.0)
+    {
+        return PRB_PER_CELL + 1; // not servable
+    }
+    const double perPrbBps = PRB_BANDWIDTH_HZ * se;
+    const double needed = std::ceil(demandBps / perPrbBps);
+    if (needed > PRB_PER_CELL)
+    {
+        return PRB_PER_CELL + 1;
+    }
+    return static_cast<uint32_t>(std::max(1.0, needed));
+}
+
+void
+CmfSimulation::UpdateRadio()
+{
+    // Everything below is expressed per PRB: RxPowerDbm() returns the per-PRB
+    // received power, so the noise has to be integrated over one PRB as well.
+    const double noiseDbm =
+        -174.0 + 10.0 * std::log10(PRB_BANDWIDTH_HZ) + m_cfg.noiseFigureDb;
+    const double noiseLin = DbToLin(noiseDbm);
+
+    for (uint32_t u = 0; u < m_ue.size(); ++u)
+    {
+        UserEquipment& ue = m_ue[u];
+
+        // Redraw the LOS state once the UE left the correlation area.
+        if (std::hypot(ue.pos.x - ue.losRefPos.x, ue.pos.y - ue.losRefPos.y) >
+            m_cfg.losCorrelationDistance)
+        {
+            for (uint32_t b = 0; b < N_BS; ++b)
+            {
+                const double d2d = std::hypot(ue.pos.x - m_bs[b].pos.x, ue.pos.y - m_bs[b].pos.y);
+                ue.los[b] = (m_uniform->GetValue() < UmaLosProbability(d2d)) ? 1 : 0;
+            }
+            ue.losRefPos = ue.pos;
+        }
+
+        const size_t base = static_cast<size_t>(u) * N_BS;
+        double totalLin = 0.0;
+        for (uint32_t b = 0; b < N_BS; ++b)
+        {
+            const double rx = RxPowerDbm(ue, b);
+            m_rxPowerDbm[base + b] = rx;
+            // Interference is weighted by the utilisation of the interfering
+            // cell: an empty cell transmits on very few PRBs.
+            totalLin += DbToLin(rx) * m_bs[b].loadPrevStep;
+        }
+
+        for (uint32_t b = 0; b < N_BS; ++b)
+        {
+            const double sLin = DbToLin(m_rxPowerDbm[base + b]);
+            // Remove the wanted cell's own contribution from the interference.
+            const double iLin = std::max(0.0, totalLin - sLin * m_bs[b].loadPrevStep);
+            const double sinrLin =
+                sLin / (iLin * DbToLin(m_cfg.interferenceMarginDb) + noiseLin);
+            m_sinrDb[base + b] = LinToDb(sinrLin);
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Mobility
+// ---------------------------------------------------------------------------
+
+void
+CmfSimulation::UpdateMobility()
+{
+    const double dt = m_cfg.stepTime;
+    for (UserEquipment& ue : m_ue)
+    {
+        if (m_uniform->GetValue() < m_cfg.directionChangeProb)
+        {
+            ue.direction = m_uniform->GetValue(0.0, 2.0 * M_PI);
+        }
+
+        Vector next(ue.pos.x + ue.speed * dt * std::cos(ue.direction),
+                    ue.pos.y + ue.speed * dt * std::sin(ue.direction),
+                    ue.pos.z);
+
+        if (!InsidePolygon(m_boundary, next))
+        {
+            // Boundary reached: pick a new direction that leads back inside.
+            bool ok = false;
+            for (int attempt = 0; attempt < 16 && !ok; ++attempt)
+            {
+                ue.direction = m_uniform->GetValue(0.0, 2.0 * M_PI);
+                next = Vector(ue.pos.x + ue.speed * dt * std::cos(ue.direction),
+                              ue.pos.y + ue.speed * dt * std::sin(ue.direction),
+                              ue.pos.z);
+                ok = InsidePolygon(m_boundary, next);
+            }
+            if (!ok)
+            {
+                continue; // stay put this step
+            }
+        }
+        ue.pos = next;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Connection handling
+// ---------------------------------------------------------------------------
+
+void
+CmfSimulation::ReleaseExpiredConnections()
+{
+    const double now = Now();
+    for (UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs >= 0 && now >= ue.connectionEnd)
+        {
+            // Free the resources right away so that the connection attempts
+            // handled later in this same step can see them.
+            BaseStation& bs = m_bs[ue.servingBs];
+            bs.prbUsed -= std::min(bs.prbUsed, ue.prbAllocated);
+            ue.servingBs = -1;
+            ue.a3Target = -1;
+            ue.lowSinrSince = -1.0;
+            ue.prbNeeded = 0;
+            ue.prbAllocated = 0;
+            ue.nextAttempt = now + std::max(1.0, m_attemptRv->GetValue());
+        }
+    }
+}
+
+void
+CmfSimulation::DetectRadioLinkFailures()
+{
+    const double now = Now();
+    for (UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs < 0)
+        {
+            continue;
+        }
+        const size_t idx = static_cast<size_t>(ue.id) * N_BS + ue.servingBs;
+        const double sinr = m_sinrDb[idx];
+        const double rsrp = m_rxPowerDbm[idx];
+        ue.connSinrDb = sinr;
+
+        const bool bad = (sinr < m_cfg.rlfSinrThresholdDb) || (rsrp < m_cfg.rxSensitivityDbm);
+        if (!bad)
+        {
+            ue.lowSinrSince = -1.0;
+            continue;
+        }
+        if (ue.lowSinrSince < 0.0)
+        {
+            ue.lowSinrSince = now;
+            continue;
+        }
+        if (now - ue.lowSinrSince < m_cfg.rlfTimer)
+        {
+            continue;
+        }
+
+        // Radio link failure: the connection is dropped.
+        BaseStation& bs = m_bs[ue.servingBs];
+        bs.rlfWindow.push_back(now);
+        bs.rlfTotal++;
+        m_rlfs++;
+        if (now >= m_cfg.warmupTime)
+        {
+            m_rlfAfterWarmup++;
+        }
+        m_rlfFile << now << "," << bs.id << "," << ue.id << "," << sinr << "," << ue.pos.x << ","
+                  << ue.pos.y << "\n";
+
+        bs.prbUsed -= std::min(bs.prbUsed, ue.prbAllocated);
+        ue.servingBs = -1;
+        ue.a3Target = -1;
+        ue.lowSinrSince = -1.0;
+        ue.prbNeeded = 0;
+        ue.prbAllocated = 0;
+        ue.nextAttempt = now + std::max(1.0, m_attemptRv->GetValue());
+    }
+}
+
+void
+CmfSimulation::RecordHandover(UserEquipment& ue, int32_t fromBs, int32_t toBs)
+{
+    const double now = Now();
+    BaseStation& source = m_bs[fromBs];
+    BaseStation& target = m_bs[toBs];
+
+    // Handovers and ping-pongs are attributed to the source cell, whose
+    // hysteresis and TTT governed the decision: that is what the MRO xApp tunes.
+    source.hoWindow.push_back(now);
+    source.hoTotal++;
+    m_handovers++;
+    if (now >= m_cfg.warmupTime)
+    {
+        m_hoAfterWarmup++;
+    }
+    m_hoFile << now << "," << source.id << "," << target.id << "," << ue.id << "," << ue.connSinrDb
+             << "," << ue.pos.x << "," << ue.pos.y << "\n";
+
+    const bool pingPong =
+        (ue.previousBs == toBs) && ((now - ue.lastHoTime) <= m_cfg.pingPongPeriod);
+    if (pingPong)
+    {
+        source.ppWindow.push_back(now);
+        source.ppTotal++;
+        m_pingPongs++;
+        if (now >= m_cfg.warmupTime)
+        {
+            m_ppAfterWarmup++;
+        }
+        m_ppFile << now << "," << target.id << "," << ue.id << "," << ue.connSinrDb << ","
+                 << ue.pos.x << "," << ue.pos.y << "," << (now - ue.lastHoTime) << "\n";
+    }
+
+    // Move the resources from the source to the target cell.
+    source.prbUsed -= std::min(source.prbUsed, ue.prbAllocated);
+    target.prbUsed += ue.prbAllocated;
+
+    ue.previousBs = fromBs;
+    ue.lastHoTime = now;
+    ue.servingBs = toBs;
+    ue.a3Target = -1;
+    ue.lowSinrSince = -1.0;
+}
+
+void
+CmfSimulation::EvaluateHandovers()
+{
+    const double now = Now();
+    for (UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs < 0)
+        {
+            continue;
+        }
+        const size_t base = static_cast<size_t>(ue.id) * N_BS;
+        const BaseStation& serving = m_bs[ue.servingBs];
+        const double servingQuality = m_rxPowerDbm[base + ue.servingBs] + serving.cio;
+
+        // A3 entering condition, evaluated against the strongest neighbour.
+        int32_t best = -1;
+        double bestQuality = -1e9;
+        for (uint32_t b = 0; b < N_BS; ++b)
+        {
+            if (static_cast<int32_t>(b) == ue.servingBs)
+            {
+                continue;
+            }
+            const double q = m_rxPowerDbm[base + b] + m_bs[b].cio;
+            if (q > bestQuality)
+            {
+                bestQuality = q;
+                best = static_cast<int32_t>(b);
+            }
+        }
+        if (best < 0)
+        {
+            continue;
+        }
+
+        const bool a3 = bestQuality > servingQuality + serving.hysteresis;
+        if (!a3)
+        {
+            ue.a3Target = -1;
+            continue;
+        }
+        if (ue.a3Target != best)
+        {
+            // Restart the Time-To-Trigger for the new candidate.
+            ue.a3Target = best;
+            ue.a3Since = now;
+            continue;
+        }
+        if (now - ue.a3Since < serving.ttt)
+        {
+            continue;
+        }
+
+        // The target must have room for the connection, otherwise the handover
+        // is not executed and the UE keeps its current cell.
+        // The UE's PRBs sit on the source cell, so the target has to have the
+        // whole demand free.
+        const uint32_t needed = PrbsNeeded(ue.demandBps, m_sinrDb[base + best]);
+        if (needed > m_bs[best].FreePrbs())
+        {
+            ue.a3Since = now; // retry after another TTT
+            continue;
+        }
+
+        RecordHandover(ue, ue.servingBs, best);
+    }
+}
+
+void
+CmfSimulation::HandleConnectionAttempts()
+{
+    const double now = Now();
+    for (UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs >= 0 || now < ue.nextAttempt)
+        {
+            continue;
+        }
+
+        const size_t base = static_cast<size_t>(ue.id) * N_BS;
+
+        // Rank the cells by received power and try the strongest ones in turn.
+        std::vector<std::pair<double, uint32_t>> ranked;
+        ranked.reserve(N_BS);
+        for (uint32_t b = 0; b < N_BS; ++b)
+        {
+            ranked.emplace_back(m_rxPowerDbm[base + b] + m_bs[b].cio, b);
+        }
+        std::sort(ranked.begin(), ranked.end(), [](const auto& a, const auto& c) {
+            return a.first > c.first;
+        });
+
+        bool admitted = false;
+        const uint32_t candidates = std::min<uint32_t>(m_cfg.admissionCandidates, N_BS);
+        for (uint32_t k = 0; k < candidates && !admitted; ++k)
+        {
+            const uint32_t b = ranked[k].second;
+            if (m_rxPowerDbm[base + b] < m_cfg.rxSensitivityDbm)
+            {
+                continue;
+            }
+            const double sinr = m_sinrDb[base + b];
+            if (sinr < m_cfg.rlfSinrThresholdDb)
+            {
+                continue;
+            }
+            const uint32_t needed = PrbsNeeded(ue.demandBps, sinr);
+            if (needed > m_bs[b].FreePrbs())
+            {
+                continue;
+            }
+
+            ue.servingBs = static_cast<int32_t>(b);
+            ue.previousBs = -1;
+            ue.lastHoTime = -1e9;
+            ue.connSinrDb = sinr;
+            ue.prbNeeded = needed;
+            ue.prbAllocated = needed;
+            ue.lowSinrSince = -1.0;
+            ue.a3Target = -1;
+            ue.connectionEnd = now + std::max(1.0, m_durationRv->GetValue());
+            m_bs[b].prbUsed += needed;
+            admitted = true;
+        }
+
+        if (!admitted)
+        {
+            // Call blockade: no cell could take the connection.
+            m_callBlockades++;
+            if (now >= m_cfg.warmupTime)
+            {
+                m_cbAfterWarmup++;
+            }
+            m_cbFile << now << "," << ue.id << "," << ue.pos.x << "," << ue.pos.y << "\n";
+            ue.nextAttempt = now + std::max(1.0, m_attemptRv->GetValue());
+        }
+    }
+}
+
+void
+CmfSimulation::AllocateResources()
+{
+    // Recompute the PRB demand of every connected UE with the current SINR, then
+    // share each cell's 100 PRBs proportionally when the cell is oversubscribed.
+    std::vector<std::vector<uint32_t>> perCell(N_BS);
+    for (UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs < 0)
+        {
+            continue;
+        }
+        const size_t idx = static_cast<size_t>(ue.id) * N_BS + ue.servingBs;
+        ue.connSinrDb = m_sinrDb[idx];
+        ue.prbNeeded = PrbsNeeded(ue.demandBps, ue.connSinrDb);
+        perCell[ue.servingBs].push_back(ue.id);
+    }
+
+    for (uint32_t b = 0; b < N_BS; ++b)
+    {
+        uint32_t demand = 0;
+        for (uint32_t ueId : perCell[b])
+        {
+            demand += m_ue[ueId].prbNeeded;
+        }
+
+        if (demand <= PRB_PER_CELL)
+        {
+            for (uint32_t ueId : perCell[b])
+            {
+                UserEquipment& ue = m_ue[ueId];
+                ue.prbAllocated = ue.prbNeeded;
+                ue.satisfaction = 1.0;
+            }
+            m_bs[b].prbUsed = demand;
+        }
+        else
+        {
+            // Proportional fair down-scaling; the cell ends up fully loaded.
+            const double scale = static_cast<double>(PRB_PER_CELL) / demand;
+            uint32_t used = 0;
+            for (uint32_t ueId : perCell[b])
+            {
+                UserEquipment& ue = m_ue[ueId];
+                const uint32_t alloc =
+                    std::max(1u, static_cast<uint32_t>(std::floor(ue.prbNeeded * scale)));
+                ue.prbAllocated = alloc;
+                ue.satisfaction =
+                    std::min(1.0, static_cast<double>(alloc) / std::max(1u, ue.prbNeeded));
+                used += alloc;
+            }
+            m_bs[b].prbUsed = std::min<uint32_t>(used, PRB_PER_CELL);
+        }
+    }
+}
