+void
+CmfSimulation::BuildBaseStations()
+{
+    // Rows of 3-4-5-4-3 cells, reproducing figures/base_stations.png of the
+    // reference repository: columns are one ISD apart, rows are one ISD apart
+    // and every other row is shifted by half an ISD. NOTE: the reference README
+    // quotes 600 m between base stations while the published figure and the
+    // coordinate range of the published traces both show 1200 m; the figure is
+    // followed here and the value is exposed as --isd.
+    static const int kRowSize[5] = {3, 4, 5, 4, 3};
+
+    m_bs.clear();
+    uint32_t nextId = 1;
+    for (int r = 0; r < 5; ++r)
+    {
+        const int count = kRowSize[r];
+        const double y = m_cfg.gridCentre.y + (r - 2) * m_cfg.isd;
+        // Centre the row on the grid centre.
+        const double x0 = m_cfg.gridCentre.x - (count - 1) * 0.5 * m_cfg.isd;
+        for (int c = 0; c < count; ++c)
+        {
+            BaseStation bs;
+            bs.id = nextId++;
+            bs.pos = Vector(x0 + c * m_cfg.isd, y, m_cfg.bsHeight);
+            bs.cio = m_cfg.defaultCio;
+            bs.hysteresis = m_cfg.defaultHysteresis;
+            bs.ttt = m_cfg.defaultTtt;
+            m_bs.push_back(bs);
+        }
+    }
+    NS_ABORT_MSG_UNLESS(m_bs.size() == N_BS, "The hexagonal grid must hold 19 cells");
+}
+
+void
+CmfSimulation::BuildBoundary()
+{
+    // Hexagon approximating the coverage border, matching the figures: vertices
+    // at +/- 2.5 ISD on the x axis and +/- 2.5 ISD on the flat top/bottom edges.
+    const double cx = m_cfg.gridCentre.x;
+    const double cy = m_cfg.gridCentre.y;
+    const double rx = 2.5 * m_cfg.isd;
+    const double ry = 2.5 * m_cfg.isd;
+    const double flat = m_cfg.isd;
+
+    m_boundary = {Vector(cx + rx, cy, 0.0),
+                  Vector(cx + flat, cy + ry, 0.0),
+                  Vector(cx - flat, cy + ry, 0.0),
+                  Vector(cx - rx, cy, 0.0),
+                  Vector(cx - flat, cy - ry, 0.0),
+                  Vector(cx + flat, cy - ry, 0.0)};
+}
+
+void
+CmfSimulation::BuildUsers()
+{
+    const double minX = m_cfg.gridCentre.x - 2.5 * m_cfg.isd;
+    const double maxX = m_cfg.gridCentre.x + 2.5 * m_cfg.isd;
+    const double minY = m_cfg.gridCentre.y - 2.5 * m_cfg.isd;
+    const double maxY = m_cfg.gridCentre.y + 2.5 * m_cfg.isd;
+
+    m_ue.clear();
+    m_ue.reserve(m_cfg.nUe);
+    for (uint32_t i = 0; i < m_cfg.nUe; ++i)
+    {
+        UserEquipment ue;
+        ue.id = i;
+
+        // Rejection sampling inside the coverage polygon.
+        Vector p;
+        do
+        {
+            p = Vector(m_uniform->GetValue(minX, maxX),
+                       m_uniform->GetValue(minY, maxY),
+                       m_cfg.ueHeight);
+        } while (!InsidePolygon(m_boundary, p));
+        ue.pos = p;
+        ue.losRefPos = p;
+
+        ue.direction = m_uniform->GetValue(0.0, 2.0 * M_PI);
+        ue.speed = (m_uniform->GetValue() < m_cfg.pedestrianShare) ? m_cfg.pedestrianSpeed
+                                                                  : m_cfg.vehicleSpeed;
+
+        const double r = m_uniform->GetValue();
+        if (r < m_cfg.profileLowProb)
+        {
+            ue.profile = 0;
+            ue.demandBps = m_cfg.profileLowBps;
+        }
+        else if (r < m_cfg.profileLowProb + m_cfg.profileMediumProb)
+        {
+            ue.profile = 1;
+            ue.demandBps = m_cfg.profileMediumBps;
+        }
+        else
+        {
+            ue.profile = 2;
+            ue.demandBps = m_cfg.profileHighBps;
+        }
+
+        // Spread the first connection attempt over one mean inter-arrival time
+        // so that the network does not start with a synchronised burst.
+        ue.nextAttempt = m_uniform->GetValue(0.0, m_cfg.attemptIntervalMean);
+
+        ue.los.assign(N_BS, 0);
+        for (uint32_t b = 0; b < N_BS; ++b)
+        {
+            const double d2d = std::hypot(ue.pos.x - m_bs[b].pos.x, ue.pos.y - m_bs[b].pos.y);
+            ue.los[b] = (m_uniform->GetValue() < UmaLosProbability(d2d)) ? 1 : 0;
+        }
+
+        m_ue.push_back(ue);
+    }
+
+    m_rxPowerDbm.assign(static_cast<size_t>(m_cfg.nUe) * N_BS, -1e9);
+    m_sinrDb.assign(static_cast<size_t>(m_cfg.nUe) * N_BS, -1e9);
+}
