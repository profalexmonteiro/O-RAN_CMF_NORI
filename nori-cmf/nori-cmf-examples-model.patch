+void
+CmfSimulation::SetupE2Terminations()
+{
+    if (!m_cfg.useE2)
+    {
+        NS_LOG_INFO("E2 disabled, the built-in MRO/MLB emulation drives the control loop");
+        return;
+    }
+
+    for (uint32_t b = 0; b < N_BS; ++b)
+    {
+        BaseStation& bs = m_bs[b];
+        bs.e2Term = CreateObject<E2Termination>(
+            m_cfg.ricIp,
+            m_cfg.ricPort,
+            static_cast<uint16_t>(m_cfg.e2LocalPort + bs.id),
+            std::to_string(bs.id),
+            PLMN_ID);
+
+        Ptr<KpmFunctionDescription> kpmFd = Create<KpmFunctionDescription>();
+        bs.e2Term->RegisterKpmCallbackToE2Sm(
+            RAN_FUNCTION_KPM,
+            kpmFd,
+            std::bind(&CmfSimulation::KpmSubscriptionCallback, this, b, std::placeholders::_1));
+
+        Ptr<RicControlFunctionDescription> ricFd = Create<RicControlFunctionDescription>();
+        bs.e2Term->RegisterSmCallbackToE2Sm(
+            RAN_FUNCTION_RC,
+            ricFd,
+            std::bind(&CmfSimulation::RicControlCallback, this, b, std::placeholders::_1));
+
+        Simulator::Schedule(MicroSeconds(0), &E2Termination::Start, bs.e2Term);
+        NS_LOG_INFO("Cell " << bs.id << " will connect to the RIC at " << m_cfg.ricIp << ":"
+                            << m_cfg.ricPort);
+    }
+}
