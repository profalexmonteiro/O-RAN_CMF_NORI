+
+/// MRO: ping-pong-to-handover ratio -> Time-To-Trigger [s].
+double
+PingPongRatioToTtt(double ratio)
+{
+    static const double kTtt[16] = {0.08,
+                                    0.08,
+                                    0.08,
+                                    0.08, // 0 - 26.67 %
+                                    0.1,
+                                    0.128,
+                                    0.16,
+                                    0.256,
+                                    0.32,
+                                    0.48,
+                                    0.512,
+                                    0.64,
+                                    1.024,
+                                    1.28,
+                                    2.56,
+                                    5.12}; // ratio == 100 %
+    const int idx = std::min(std::max(static_cast<int>(std::floor(ratio * 15.0)), 0), 15);
+    return kTtt[idx];
+}
+
+/// MRO: RLF-to-handover ratio -> hysteresis [dB].
+double
+RlfRatioToHysteresis(double ratio)
+{
+    // 0 - 15 % maps to 1 dB, then +0.5 dB every 5 %.
+    const int idx = std::min(std::max(static_cast<int>(std::floor(ratio * 20.0)), 0), 20);
+    return 1.0 + 0.5 * std::max(0, idx - 2);
+}
+
+/// MLB: cell load -> Cell Individual Offset [dB].
+double
+LoadToCio(double load)
+{
+    // 0 - 45.45 % maps to 0 dB, then +0.5 dB every 9.09 % (1/11).
+    const int idx = std::min(std::max(static_cast<int>(std::floor(load * 11.0)), 0), 11);
+    return 0.5 * std::max(0, idx - 4);
+}
