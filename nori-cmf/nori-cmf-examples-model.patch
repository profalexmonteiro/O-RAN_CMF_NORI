+    Simulator::ScheduleWithContext(1, Seconds(0), &CmfSimulation::SendKpmIndication, this, bsIdx);
+}
+
+void
+CmfSimulation::SendKpmIndication(uint32_t bsIdx)
+{
+    BaseStation& bs = m_bs[bsIdx];
+    if (!bs.e2Subscribed || bs.e2Term == nullptr)
+    {
+        return;
+    }
+
+    const double now = Now();
+    PruneWindow(bs.hoWindow, now);
+    PruneWindow(bs.ppWindow, now);
+    PruneWindow(bs.rlfWindow, now);
+
+    uint32_t activeUes = 0;
+    double satisSum = 0.0;
+    for (const UserEquipment& ue : m_ue)
+    {
+        if (ue.servingBs == static_cast<int32_t>(bsIdx))
+        {
+            activeUes++;
+            satisSum += ue.satisfaction;
+        }
+    }
+
+    // --- Indication header ---
+    KpmIndicationHeader::KpmRicIndicationHeaderValues headerValues;
+    headerValues.m_plmId = PLMN_ID;
+    headerValues.m_gnbId = std::to_string(bs.id);
+    headerValues.m_nrCellId = bs.id;
+    headerValues.m_timestamp = static_cast<uint64_t>(Simulator::Now().GetMilliSeconds());
+    auto header =
+        Create<KpmIndicationHeader>(KpmIndicationHeader::GlobalE2nodeType::gNB, headerValues);
+
+    // --- O-DU measurement container ---
+    auto qciReport = Create<EpcDuPmContainer>();
+    qciReport->m_qci = 1;
+    qciReport->m_dlPrbUsage = static_cast<long>(bs.prbUsed); // 100 PRBs, so already a percentage
+    qciReport->m_ulPrbUsage = 0;
+
+    auto servedPlmn = Create<ServedPlmnPerCell>();
+    servedPlmn->m_plmId = PLMN_ID;
+    servedPlmn->m_nrCellId = bs.id;
+    servedPlmn->m_perQciReportItems.insert(qciReport);
+
+    auto cellReport = Create<CellResourceReport>();
+    cellReport->m_plmId = PLMN_ID;
+    cellReport->m_nrCellId = bs.id;
+    cellReport->dlAvailablePrbs = PRB_PER_CELL;
+    cellReport->ulAvailablePrbs = PRB_PER_CELL;
+    cellReport->m_servedPlmnPerCellItems.insert(servedPlmn);
+
+    auto duValues = Create<ODuContainerValues>();
+    duValues->m_cellResourceReportItems.insert(cellReport);
+
+    // --- Cell measurement items consumed by the MRO and MLB xApps ---
+    auto cellItems = Create<MeasurementItemList>();
+    cellItems->AddItem<long>("RRU.PrbUsedDl", static_cast<long>(bs.prbUsed));
+    cellItems->AddItem<long>("RRU.PrbAvailDl", static_cast<long>(PRB_PER_CELL));
+    cellItems->AddItem<long>("DRB.MeanActiveUeDl", static_cast<long>(activeUes));
+    cellItems->AddItem<long>("HO.TotNbrOut", static_cast<long>(bs.hoWindow.size()));
+    cellItems->AddItem<long>("HO.PingPongNbrOut", static_cast<long>(bs.ppWindow.size()));
+    cellItems->AddItem<long>("RRC.ReEstabAtt.RLF", static_cast<long>(bs.rlfWindow.size()));
+    // Current values of the contended parameters, in milli-units so that they
+    // survive the integer encoding of the KPM measurement values.
+    cellItems->AddItem<long>("MLB.CioMilliDb", std::lround(bs.cio * 1000.0));
+    cellItems->AddItem<long>("MRO.HysteresisMilliDb", std::lround(bs.hysteresis * 1000.0));
+    cellItems->AddItem<long>("MRO.TimeToTriggerMs", std::lround(bs.ttt * 1000.0));
+    cellItems->AddItem<long>("QoS.MeanUeSatisfactionPermille",
+                             activeUes ? std::lround(1000.0 * satisSum / activeUes) : 0L);
+
+    KpmIndicationMessage::KpmIndicationMessageValues msgValues;
+    msgValues.m_cellObjectId = "NRCellDU_" + std::to_string(bs.id);
+    msgValues.m_pmContainerValues = duValues;
+    msgValues.m_cellMeasurementItems = cellItems;
+    auto message = Create<KpmIndicationMessage>(msgValues);
+
+    auto* pdu = new E2AP_PDU;
+    encoding::generate_e2apv1_indication_request_parameterized(pdu,
+                                                              bs.e2SubParams.requestorId,
+                                                              bs.e2SubParams.instanceId,
+                                                              bs.e2SubParams.ranFuncionId,
+                                                              bs.e2SubParams.actionId,
+                                                              1,
+                                                              (uint8_t*)header->m_buffer,
+                                                              header->m_size,
+                                                              (uint8_t*)message->m_buffer,
+                                                              message->m_size);
+    bs.e2Term->SendE2Message(pdu);
+    delete pdu;
+
+    if (now + m_cfg.e2Periodicity <= m_cfg.simTime + 1e-9)
+    {
+        Simulator::ScheduleWithContext(1,
+                                       Seconds(m_cfg.e2Periodicity),
+                                       &CmfSimulation::SendKpmIndication,
+                                       this,
+                                       bsIdx);
+    }
+}
