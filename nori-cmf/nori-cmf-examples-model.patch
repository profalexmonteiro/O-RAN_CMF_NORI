+/// Ray-casting point-in-polygon test.
+bool
+InsidePolygon(const std::vector<Vector>& poly, const Vector& p)
+{
+    bool inside = false;
+    const size_t n = poly.size();
+    for (size_t i = 0, j = n - 1; i < n; j = i++)
+    {
+        const double xi = poly[i].x;
+        const double yi = poly[i].y;
+        const double xj = poly[j].x;
+        const double yj = poly[j].y;
+        if (((yi > p.y) != (yj > p.y)) && (p.x < (xj - xi) * (p.y - yi) / (yj - yi) + xi))
+        {
+            inside = !inside;
+        }
+    }
+    return inside;
+}
+
+/// Jain's fairness index; NaN when every sample is zero.
+double
+JainFairness(const std::vector<double>& x)
+{
+    double sum = 0.0;
+    double sumSq = 0.0;
+    for (double v : x)
+    {
+        sum += v;
+        sumSq += v * v;
+    }
+    if (sumSq <= 0.0)
+    {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    return (sum * sum) / (static_cast<double>(x.size()) * sumSq);
+}
