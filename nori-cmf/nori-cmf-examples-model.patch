+
+/// TR 38.901 Table 7.4.2-1, UMa LOS probability for hUT < 13 m.
+double
+UmaLosProbability(double d2d)
+{
+    if (d2d <= 18.0)
+    {
+        return 1.0;
+    }
+    return 18.0 / d2d + std::exp(-d2d / 63.0) * (1.0 - 18.0 / d2d);
+}
+
+/// TR 38.901 Table 7.4.1-1, UMa pathloss [dB].
+double
+UmaPathloss(double d2d, double hBs, double hUt, double fcGhz, bool los)
+{
+    d2d = std::max(d2d, 10.0); // the model is only defined from 10 m on
+    const double dh = hBs - hUt;
+    const double d3d = std::sqrt(d2d * d2d + dh * dh);
+    // Effective environment height, 1 m for hUT below 13 m.
+    const double hE = 1.0;
+    const double dBp = 4.0 * (hBs - hE) * (hUt - hE) * (fcGhz * 1e9) / 3e8;
+
+    double plLos;
+    if (d2d <= dBp)
+    {
+        plLos = 28.0 + 22.0 * std::log10(d3d) + 20.0 * std::log10(fcGhz);
+    }
+    else
+    {
+        plLos = 28.0 + 40.0 * std::log10(d3d) + 20.0 * std::log10(fcGhz) -
+                9.0 * std::log10(dBp * dBp + dh * dh);
+    }
+    if (los)
+    {
+        return plLos;
+    }
+    const double plNlos =
+        13.54 + 39.08 * std::log10(d3d) + 20.0 * std::log10(fcGhz) - 0.6 * (hUt - 1.5);
+    return std::max(plLos, plNlos);
+}
